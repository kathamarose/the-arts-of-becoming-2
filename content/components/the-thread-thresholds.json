{
  "name": "the-thread-thresholds",
  "label": "Thresholds",
  "description": "Brought across from a page made elsewhere; every word, picture and link is a field.",
  "version": 1,
  "fields": {
    "body": {
      "kind": "richText",
      "label": "Body",
      "marks": [
        "bold",
        "italic",
        "link"
      ],
      "blocks": [
        "paragraph",
        "heading",
        "bulletList",
        "orderedList",
        "blockquote"
      ]
    }
  },
  "defaults": {
    "body": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "There are seasons when you know something is changing, but you can't quite name what the next shape is."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Old ways no longer fit. Something is asking to be felt, released, claimed, created or lived differently."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "You may not need another system to follow. You may need space to hear yourself."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "The Thread is a private mentorship for those thresholds.",
              "marks": [
                {
                  "type": "bold"
                }
              ]
            },
            {
              "type": "text",
              "text": " Together, we listen for what is most alive and follow it."
            }
          ]
        }
      ]
    }
  },
  "template": "<section class=\"i-thresholds\">{{rich body class=\"wrap center\"}}</section>",
  "css": ":scope{--ink:var(--os-color-text);--sans:'Hanken Grotesk',system-ui,sans-serif;--gap:clamp(56px,9vw,120px)}\n:scope{color:var(--ink);font-family:var(--sans);font-size:17px;line-height:1.7}\n:where(h1,h2,h3,h4,h5,h6){color:inherit;font-family:inherit;font-weight:bold;font-style:inherit;letter-spacing:normal;text-transform:none;line-height:inherit;text-wrap:wrap}\n:where(h1){font-size:2em}:where(h2){font-size:1.5em}:where(h3){font-size:1.17em}:where(h4){font-size:1em}:where(h5){font-size:.83em}:where(h6){font-size:.67em}\n:where(.os-ci){display:inline-block;max-width:100%;vertical-align:middle;aspect-ratio:auto}\n.os-ci>picture{display:contents}\n.os-ci img{display:block;width:100%;height:100%;object-fit:inherit;object-position:inherit;border-radius:inherit}\n*{box-sizing:border-box}\np{margin:0 0 1.1em;max-width:62ch}\n.wrap{max-width:1080px;margin:0 auto;padding:0 24px}\nsection{padding:var(--gap) 0}\n.center{text-align:center}\n.center p{margin-left:auto;margin-right:auto}",
  "section": {
    "width": "full",
    "padding": {
      "d": "none"
    }
  }
}
