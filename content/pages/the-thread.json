            "rows": [
              {
                "cards": [
                  {
                    "cell": "The Art of Life"
                  },
                  {
                    "cell": "direction, purpose, rhythm, values, choices, lifestyle + alignment"
                  }
                ]
              },
              {
                "cards": [
                  {
                    "cell": "Embodied Liberation"
                  },
                  {
                    "cell": "body, emotion, conditioning, nervous system, expression + freedom"
                  }
                ]
              },
              {
                "cards": [
                  {
                    "cell": "The Threshold"
                  },
                  {
                    "cell": "transitions, endings, beginnings, identity shifts + rites of passage"
                  }
                ]
              },
              {
                "cards": [
                  {
                    "cell": "The Practice"
                  },
                  {
                    "cell": "yoga, meditation, breath, ritual + everyday devotion"
                  }
                ]
              },
              {
                "cards": [
                  {
                    "cell": "Truth in Love"
                  },
                  {
                    "cell": "intimacy, communication, relational patterns, boundaries + belonging"
                  }
                ]
              },
              {
                "cards": [
                  {
                    "cell": "The Feminine"
                  },
                  {
                    "cell": "receptivity, cycles, sensuality, womb wisdom, sovereignty + expression"
                  }
                ]
              },
              {
                "cards": [
                  {
                    "cell": "The Mystic"
                  },
                  {
                    "cell": "intuition, symbolism, ritual, divination, mystery + spiritual relationship"
                  }
                ]
              },
              {
                "cards": [
                  {
                    "cell": "The Sensitive Self"
                  },
                  {
                    "cell": "boundaries, sensitivity, discernment, energetic awareness + grounding"
                  }
                ]
              },
              {
                "cards": [
                  {
                    "cell": "The Creator"
                  },
                  {
                    "cell": "artistry, voice, creative blocks, visibility, expression + bringing vision into form"
                  }
                ]
              },
              {
                "cards": [
                  {
                    "cell": "Nature + Belonging"
                  },
