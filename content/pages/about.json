      "blocks": [
        {
          "id": "blk_3enykhw0jq",
          "type": "component/about-thread-beneath",
          "v": 1,
          "fields": {
            "heading": "The thread beneath everything.",
            "text": "By tracking cycles and patterns, through the seasons and stars, I weave my listening into teachings, creative projects, and community and land stewardship. To remember the medicine we each uniquely are. To remember magic and beauty, even in the seemingly mundane. To remember what it means to truly become in beauty and live true to essence.",
            "cta": {
              "type": "page",
              "page": "pg_8fjexcpefr"
            },
            "ctaLabel": "Say hello"
          }
        }
      ]
    }
