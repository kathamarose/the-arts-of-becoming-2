          "fields": {
            "title": "Kathleen Marie Rose",
            "text": "The artist behind the weaving.",
            "medicine": "I make beauty in reverence to the intimate dance of nature + soul, the human journey of remembering, and the liberation of Life."
          }
        }
      ]
    },
    {
      "id": "sec_hwp9435bb2",
      "preset": "component/about-renaissance@1",
      "label": "A regenerative Renaissance woman.",
      "anchor": "renaissance",
      "layout": {
        "mode": "stack",
