          "v": 1,
          "fields": {
            "heading": "Creative Work",
            "heading2": "Creation is one of the ways Life knows itself.",
            "lines": [
              {
                "lines": "Photography. Poetry. Writing."
              },
              {
                "lines": "Music. Design. Visual worlds. Story."
              }
            ],
            "text": "Some things I create as offerings. Others I create because they ask to exist. Welcome to the studio.",
