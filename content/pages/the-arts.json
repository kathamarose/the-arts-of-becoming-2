        {
          "id": "blk_kk2dc61cnq",
          "type": "component/the-arts-earth",
          "v": 1,
          "fields": {
            "heading": "Earth + Living Systems",
            "heading2": "To tend life is to be tended by life.",
            "paragraphs": [
              {
                "text": "Our becoming does not end at the skin. We live inside relationships with land, food, plants, seasons, homes, watersheds, communities and innumerable living beings."
              },
              {
                "text": "My earth work is rooted in remembering those relationships, and creating landscapes and ways of living that participate more consciously in them."
              }
            ],
            "cards": [
              {
                "heading": "Garden + Landscape Design"
              },
              {
                "heading": "Herbalism + Plant Relationship"
              },
              {
                "heading": "Seasonal + Regenerative Living"
              }
            ]
          }
        }
      ]
    },
