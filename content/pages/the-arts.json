      "blocks": [
        {
          "id": "blk_0ss347khga",
          "type": "component/the-arts-embodiment",
          "v": 1,
          "fields": {
            "heading": "Embodiment + Practice",
            "heading2": "The body is a door.",
            "text": "Yoga taught me early that self-knowledge is not only intellectual. We learn by breathing. Moving. Feeling. Pausing. Meeting resistance. Opening. Strengthening. Softening. Returning.",
            "cards": [
              {
                "heading": "FlowAsana",
                "text": "Alignment-based yoga + qi gong + intuitive movement + breath + stillness."
              },
              {
                "heading": "Meditation",
                "text": "Silent and guided practice."
              },
              {
                "heading": "Return to Her",
                "text": "Women's embodiment and feminine reclamation."
              },
              {
                "heading": "Workshops",
                "text": "Seasonal embodiment, relationship, sensuality, ritual and more."
              }
            ]
          }
        }
      ]
    },
    {
      "id": "sec_wngnbsnx20",
      "preset": "component/the-arts-circles@1",
      "label": "Courses + Circles",
      "anchor": "circles",
      "layout": {
        "mode": "stack",
        "columns": {
          "d": [
            12
          ]
        },
        "width": "full"
      },
      "style": {
        "colorTheme": "light",
