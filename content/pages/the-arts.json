          "d": "none"
        }
      },
      "blocks": [
        {
          "id": "blk_epwz88t2m9",
          "type": "component/the-arts-circles",
          "v": 1,
          "fields": {
            "heading": "Courses + Circles",
            "heading2": "We become in relationship.",
            "text": "Not all becoming needs to happen alone. There is medicine in practicing together. Being witnessed. Hearing another person's story. Recognizing ourselves in one another. Letting community become part of the mirror.",
            "cards": [
              {
                "heading": "Ecstatic by Nature",
                "text": "A seven-part earth, body and ecstatic embodiment course."
              },
              {
                "heading": "Story Weaving",
                "text": "Storytelling for self-actualization + collective becoming."
              },
              {
                "heading": "Return to Her",
                "text": "Women's embodiment, offered as a cohort."
              },
              {
                "heading": "Seasonal Gatherings",
                "text": "Whatever is alive now."
              }
            ]
          }
        }
      ]
    },
    {
      "id": "sec_qkn6mxcrdb",
      "preset": "component/the-arts-earth@1",
