          "id": "blk_c481xfdg8q",
          "type": "component/true-to-essence-a-world-of-its-own",
          "v": 1,
          "fields": {
            "body": {
              "type": "doc",
              "content": [
                {
                  "type": "heading",
                  "attrs": {
                    "level": 2
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "A world of its own."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "True To Essence is part of The Arts of Becoming, and it lives in its own home, with its own portfolio, sessions and way of working."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Here, the camera becomes more than documentation. It becomes mirror, witness, stage, archive and play. Rather than asking you to perform for the camera, I create space for you to move, explore, play, feel, relate + be seen, to make images that feel like you."
                    }
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "sec_c4rt16fpbm",
      "preset": "component/true-to-essence-approach@1",
