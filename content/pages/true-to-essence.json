      "blocks": [
        {
          "id": "blk_y42pxb6knm",
          "type": "component/true-to-essence-approach",
          "v": 1,
          "fields": {
            "cards": [
              {
                "heading": "Soulcentric Photography",
                "text": "It is less about perfect posing and more about presence. Less about constructing an image of who you should be and more about revealing something true."
              },
              {
                "heading": "Portrait Medicine",
                "text": "Within intimate portrait work, the camera becomes a mirror, the photograph becomes an artifact, and being witnessed becomes an opportunity to meet yourself differently."
              }
            ]
          }
        }
      ]
    },
