    {
      "id": "sec_eztp99ye10",
      "preset": "component/premise@1",
      "label": "There is an art to becoming who you are.",
      "anchor": "premise",
      "layout": {
        "mode": "stack",
        "columns": {
          "d": [
            12
          ]
        },
        "width": "full"
      },
      "style": {
        "colorTheme": "light",
        "padding": {
          "d": "none"
        }
      },
      "blocks": [
        {
          "id": "blk_wtj3y3h2yt",
          "type": "component/premise",
          "v": 1,
          "fields": {
            "heading": "There is an art to becoming who you are.",
            "lines": [
              {
                "lines": "Not becoming someone else."
              },
              {
                "lines": "Not perfecting yourself into some final form."
              }
            ],
            "text": "But learning to see what is here. To know what is true. To loosen what obscures it. To listen for what wants to move through you. And to cultivate a life that can hold more of who you actually are.",
            "text2": "This is the heart of my work. A practice of remembering and becoming, again and again."
          }
        }
      ]
    },
    {
      "id": "sec_exdw8ee30z",
      "preset": "component/living-practice@1",
      "label": "See · Liberate · Create · Cultivate",
      "anchor": "living-practice",
      "layout": {
        "mode": "stack",
        "columns": {
          "d": [
            12
          ]
        },
        "width": "full"
      },
      "style": {
        "colorTheme": "light",
        "padding": {
          "d": "none"
        }
      },
      "blocks": [
        {
          "id": "blk_523q2nqxjh",
          "type": "component/living-practice",
          "v": 1,
          "fields": {
            "kicker": "A living practice",
            "heading": "See · Liberate · Create · Cultivate",
            "text": "We align. We wander. We listen. We return.",
            "cards": [
              {
                "sub": "Awareness · Reflection · Self-study",
                "heading": "See",
                "text": "Meet what is actually here. Witness yourself, your patterns, your beauty, your stories, your desires, your edges and the life moving around you."
              },
              {
                "sub": "Feeling · Reclamation · Release",
                "heading": "Liberate",
                "text": "Meet what constricts your aliveness. Uncover conditioning. Feel what has been waiting to be felt. Reclaim forgotten parts."
              },
              {
                "sub": "Expression · Choice · Art",
                "heading": "Create",
                "text": "Give form to what you discover. Your voice. Your movement. Your work. Your imagery. Your relationships. Your next chapter."
              },
              {
                "sub": "Practice · Integration · Stewardship",
                "heading": "Cultivate",
                "text": "Tend what you wish to become. Through repetition, relationship, ritual, nourishment and care, create the conditions in which a truer life can grow."
              }
            ],
            "text2": "These are not steps. They are movements in a living spiral."
          }
        }
      ]
    },
    {
      "id": "sec_pt2b4x5v5e",
      "preset": "component/the-arts@1",
      "label": "The Arts",
      "anchor": "the-arts",
      "layout": {
        "mode": "stack",
        "columns": {
          "d": [
            12
