          "v": 1,
          "fields": {
            "kicker": "Soulcentric Photography",
            "heading": "Photography for the evolutionary being.",
            "paragraphs": [
              {
                "text": "There are ways of knowing ourselves that thought alone cannot reach. Sometimes we need a mirror. Sometimes we need a stage. Sometimes we need to be witnessed becoming the thing we already feel ourselves becoming."
              },
              {
                "text": "True To Essence is my photographic practice, and it lives in its own home."
              }
            ],
            "cta": {
              "type": "page",
