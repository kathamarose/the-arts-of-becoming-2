          "fields": {
            "heading": "Hi, I'm Kathleen.",
            "text": "Artist, photographer, teacher, guide + regenerative Renaissance woman.",
            "text2": "I have spent much of my life exploring the intimate dance between nature and soul. My work has moved through many forms: yoga and meditation, embodiment, healing arts, photography, storytelling, design, herbalism, permaculture, community-building and creative practice.",
            "text3": "I used to wonder how they were all supposed to fit together. Eventually I understood:",
            "text4": "the weaving is the work.",
            "cta": {
              "type": "page",
              "page": "pg_xq22mpj50y"
            },
            "ctaLabel": "Meet Kathleen"
          }
