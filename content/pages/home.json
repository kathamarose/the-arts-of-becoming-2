      "blocks": [
        {
          "id": "blk_s5d7a3a7sy",
          "type": "component/the-thread",
          "v": 1,
          "fields": {
            "kicker": "1:1 mentorship",
            "heading": "The Thread",
            "heading2": "One life. Many threads.",
            "paragraphs": [
              {
                "text": "The Thread is a personalized mentorship for meeting the chapter you are actually living. There is no single curriculum for becoming."
              },
              {
                "text": "We begin with what is alive: where you are, what is changing, what is asking for attention, what you long for, what you are becoming. From there, I draw from the arts and practices I have spent my life studying and living to shape a journey around you."
              }
            ],
            "lines": [
              {
                "lines": "Embodiment. Story. Meditation. Yoga."
              },
              {
                "lines": "Relationship. Sensuality. Nature."
              },
              {
                "lines": "Creative practice. Ritual. Pattern tracking. Life design."
              }
            ],
            "text": "We follow the thread.",
            "cta": {
              "type": "page",
              "page": "pg_kpzgwm4pmk"
            },
            "ctaLabel": "Explore The Thread"
          }
        }
      ]
    },
